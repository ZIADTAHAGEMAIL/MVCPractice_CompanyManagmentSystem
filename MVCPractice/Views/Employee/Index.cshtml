@model IEnumerable<MVCPractice.Models.Employee>

@{
    ViewData["Title"] = "الموظفين";
}

<!-- زر الرجوع المباشر للداشبورد -->
<div class="mb-3">
    <button type="button"
            class="btn btn-outline-secondary"
            onclick="window.location.href='/Dashboard/Index';">
        ← رجوع للرئيسية
    </button>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>قائمة الموظفين</h2>
    <a asp-controller="Employee" asp-action="Add" class="btn btn-primary">
        إضافة موظف
    </a>
</div>

<table class="table table-bordered table-striped mt-4">
    <thead class="table-dark">
        <tr>
            <th>الاسم</th>
            <th>القسم</th>
            <th>المشاريع</th>
            <th>الإجراءات</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@(item.Department != null ? item.Department.Name : "بدون قسم")</td>
                    <td>
                        @if (item.EmpPrjs != null && item.EmpPrjs.Any(ep => ep.Project != null))
                        {
                            <ul class="mb-0">
                                @foreach (var empPrj in item.EmpPrjs)
                                {
                                    if (empPrj.Project != null)
                                    {
                                        <li>@empPrj.Project.Title</li>
                                    }
                                }
                            </ul>
                        }
                        else
                        {
                            <span class="text-muted">غير مشارك في أي مشروع</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="Employee" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">تعديل</a>
                        <a asp-controller="Employee" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">حذف</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">لا يوجد موظفون مسجلون حالياً.</td>
            </tr>
        }
    </tbody>
</table>