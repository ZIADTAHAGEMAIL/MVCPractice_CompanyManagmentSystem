@model IEnumerable<MVCPractice.Models.Department>

@{
    ViewData["Title"] = "قائمة الأقسام";
}

<div class="mb-3">
    <button type="button"
            class="btn btn-outline-secondary"
            onclick="window.location.href='/Dashboard/Index';">
        ← رجوع للرئيسية
    </button>
</div>

<!-- رسائل التنبيه والنجاح -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>⚠️ تنبيه: </strong> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <strong>✓ نجاح: </strong> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>قائمة الأقسام</h2>
    <a asp-action="Add" class="btn btn-success">+ إضافة قسم جديد</a>
</div>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th style="width: 80px;"># الرقم</th>
            <th style="width: 250px;">اسم القسم</th>
            <th>الوصف</th>
            <th class="text-center" style="width: 220px;">العمليات</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var dept in Model)
            {
                <tr>
                    <td>@dept.Id</td>
                    <td class="fw-bold">@dept.Name</td>
                    <td>
                        @if (!string.IsNullOrEmpty(dept.Description))
                        {
                            <span>@dept.Description</span>
                        }
                        else
                        {
                            <span class="text-muted small">لا يوجد وصف</span>
                        }
                    </td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@dept.Id" class="btn btn-primary btn-sm me-1">
                            تعديل
                        </a>

                        <form asp-action="Delete" asp-route-id="@dept.Id" method="post" class="d-inline" onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف هذا القسم؟');">
                            <button type="submit" class="btn btn-danger btn-sm">حذف</button>
                        </form>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">لا توجد أقسام مسجلة حالياً.</td>
            </tr>
        }
    </tbody>
</table>